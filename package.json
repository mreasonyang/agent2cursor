{
  "name": "@kyun.si/agent2cursor",
  "version": "0.1.0",
  "description": "Convert Claude Code and Codex agents and skills into editable Cursor Agent SDK projects, with field-by-field migration reports.",
  "type": "module",
  "bin": {
    "agent2cursor": "dist/cli.js"
  },
  "files": [
    "dist",
    "templates",
    "demos",
    "docs/assets",
    "docs/evidence",
    "docs/official-examples.provenance.json",
    "docs/acceptance.md",
    "docs/upstream-verification.md",
    "evaluation/README.md",
    "evaluation/20261027-2216/复测结论.md",
    "README.md",
    "README.zh-CN.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc",
    "test": "tsx --test test/*.test.ts",
    "check": "npm run build && npm test",
    "dev": "tsx src/cli.ts",
    "prepack": "npm run build",
    "pack:local": "npm run build && node scripts/npm-release.mjs pack",
    "verify:package": "node scripts/npm-release.mjs verify",
    "publish:npm": "node scripts/npm-release.mjs publish",
    "test:sdk": "node scripts/verify-sdk.mjs"
  },
  "author": "Eason Yang (@mr_easonyang)",
  "license": "MIT",
  "dependencies": {
    "commander": "^14.0.0",
    "smol-toml": "^1.9.1",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "private": true,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mreasonyang/agent2cursor.git"
  },
  "homepage": "https://github.com/mreasonyang/agent2cursor",
  "bugs": {
    "url": "https://github.com/mreasonyang/agent2cursor/issues"
  }
}
